meta {
  name: List Favorite Genres
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/users/{{username}}/favorites/genres?page=1&limit=20
}

params:query {
  page: 1
  limit: 20
}

docs {
  Paginated favorite genres from the liked set (`{ name, count }`).

  Sorted by count desc, then name asc. `limit` default 20, max 100.
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("items is an array", function() {
    expect(res.body.items).to.be.an("array");
  });
}
