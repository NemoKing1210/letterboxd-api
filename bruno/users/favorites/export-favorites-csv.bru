meta {
  name: Export Favorites CSV
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/users/{{username}}/favorites/export/csv?sort=rating_desc
}

params:query {
  ~genre: sci-fi
  sort: rating_desc
  ~limit: 100
}

docs {
  Export favorite movies as CSV (UTF-8).
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
