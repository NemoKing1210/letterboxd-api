meta {
  name: Get User Profile
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/{{username}}
}

docs {
  Returns the user profile (counts, genres, following/followers, pinned favorite films, recent likes, external links).
  If the user is missing locally, the API triggers a Letterboxd sync (lazy).
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("username matches", function() {
    expect(res.body.username).to.equal(bru.getEnvVar("username"));
  });
}
