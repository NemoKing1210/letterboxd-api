# PostgreSQL — option A: discrete parts (convenient for OpenServer / local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=letterboxd
DB_SCHEMA=public

# PostgreSQL — option B: full URL (Supabase / managed). Wins over DB_* if set.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/letterboxd?schema=public

# Supabase (optional — for future storage/auth)
SUPABASE_URL=
SUPABASE_KEY=

# Outbound HTTP proxy (optional — Letterboxd scrape and future external APIs)
# HTTPS_PROXY=http://user:pass@127.0.0.1:8080
# HTTP_PROXY=http://user:pass@127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1

# Letterboxd scraper
LETTERBOXD_TIMEOUT=15000
LETTERBOXD_PAGE_DELAY_MS=500
LETTERBOXD_MAX_PAGES=50
# Concurrent on-demand film-page enrichments when serving API responses
LETTERBOXD_ENRICH_CONCURRENCY=8
# Application-level retries per film during on-demand enrichment
LETTERBOXD_ENRICH_RETRIES=3

# Cache
CACHE_TTL=300
# Re-sync user data on GET when last successful sync is older than this (seconds). 0 = only sync when user is missing.
USER_SYNC_TTL_SECONDS=43200

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=*
