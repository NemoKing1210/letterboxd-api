# PostgreSQL connection (Supabase or local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/letterboxd?schema=public

# Supabase (optional — for future storage/auth)
SUPABASE_URL=
SUPABASE_KEY=

# Letterboxd scraper
LETTERBOXD_TIMEOUT=15000
LETTERBOXD_PAGE_DELAY_MS=500
LETTERBOXD_MAX_PAGES=50

# Cache
CACHE_TTL=300

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=*
