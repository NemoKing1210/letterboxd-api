################################################################################
# Letterboxd API — environment template
# Copy to `.env` and adjust. Never commit real secrets.
# Docs: README.md · docs/supabase.md · docs/vercel.md · docs/api.md
# Vercel-only minimal list: .env.vercel.example
################################################################################

# =============================================================================
# Database (required)
# Provide either discrete DB_* parts (A) or a full DATABASE_URL (B).
# If DATABASE_URL is set, it wins over DB_*.
# =============================================================================

# --- A) Discrete parts (OpenServer / local Postgres) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=letterboxd
DB_SCHEMA=public

# --- B) Full URL (Supabase / managed Postgres) ---
# Local Docker example:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/letterboxd?schema=public
# Supabase app/runtime (transaction pooler :6543) — see docs/supabase.md:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true
# Supabase migrations: use Direct :5432 or Session pooler :5432 (not transaction mode)

# =============================================================================
# Server
# =============================================================================

PORT=3000
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace

# =============================================================================
# Authentication (optional — API is open when AUTH_ENABLED=false)
# When enabled, all paths except AUTH_PUBLIC_PATHS require credentials.
# Any method listed in AUTH_METHODS may succeed (OR logic).
# =============================================================================

AUTH_ENABLED=false

# Methods (CSV): api_key | bearer | basic
#   api_key  → header X-API-Key
#   bearer   → header Authorization: Bearer <token>
#   basic    → HTTP Basic (AUTH_BASIC_USERNAME / AUTH_BASIC_PASSWORD)
AUTH_METHODS=api_key,bearer

# Shared secrets for api_key and bearer (CSV = rotation: old,new)
AUTH_TOKENS=

# Required only when AUTH_METHODS includes basic
AUTH_BASIC_USERNAME=
AUTH_BASIC_PASSWORD=

# Exact paths that skip auth (CSV). Keep /health for probes;
# /privacy and /openapi-gpt-actions.yaml stay public for ChatGPT Custom GPT Actions.
AUTH_PUBLIC_PATHS=/health,/privacy,/openapi-gpt-actions.yaml

# =============================================================================
# HTTP access control
# =============================================================================

# Allowed CORS origins: * or comma-separated list
CORS_ORIGIN=*

# Per-IP rate limit window and max requests in that window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# =============================================================================
# Cache & sync freshness
# =============================================================================

# In-memory response cache TTL (seconds)
CACHE_TTL=300

# Re-sync on user GET when last successful sync is older than this (seconds).
# 0 = sync only when the user is missing locally.
USER_SYNC_TTL_SECONDS=43200

# =============================================================================
# Letterboxd scraper
# =============================================================================

LETTERBOXD_TIMEOUT=15000             # outbound HTTP timeout (ms)
LETTERBOXD_PAGE_DELAY_MS=500         # delay between list pages (ms)
LETTERBOXD_MAX_PAGES=50              # max pages per films/diary scrape

# On-demand film-page enrichment when serving API responses
LETTERBOXD_ENRICH_CONCURRENCY=8      # parallel enrichments
LETTERBOXD_ENRICH_RETRIES=3          # retries per film

# =============================================================================
# Outbound HTTP proxy (optional)
# Used for Letterboxd scrape and other external HTTP.
# =============================================================================

# HTTPS_PROXY=http://user:pass@127.0.0.1:8080
# HTTP_PROXY=http://user:pass@127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1

# =============================================================================
# Supabase client (optional — reserved; Prisma uses DATABASE_URL only today)
# If you later adopt supabase-js, prefer publishable + secret keys from the
# dashboard (legacy anon / service_role names still work for compatibility).
# Never expose service_role / secret keys in browsers.
# =============================================================================

# SUPABASE_URL=
# SUPABASE_KEY=

# =============================================================================
# OpenAI recommendations (optional — v3)
# Without OPENAI_API_KEY the API keeps the rule-based recommendation engine.
# Requires PostgreSQL with the pgvector extension (see prisma migrations).
# =============================================================================

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=30000
# OPENAI_MAX_RETRIES=3

# auto = AI when OPENAI_API_KEY is set, otherwise rules | ai | rules
# RECOMMENDATION_ENGINE=auto
# AI_RECOMMEND_CANDIDATE_POOL=20   # ANN candidates before optional LLM rerank
# AI_EMBED_BUDGET=48              # max movies embedded lazily per request / sync
# AI_EMBED_BATCH_SIZE=16
# AI_RECOMMEND_USE_LLM=true       # false = ANN + template reasons only
