{
  "name": "letterboxd-api",
  "version": "1.4.0",
  "description": "Production-ready Letterboxd API — analyze, filter, and understand film taste",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "bun run scripts/run-prisma.ts migrate dev",
    "db:migrate:deploy": "bun run scripts/run-prisma.ts migrate deploy",
    "db:studio": "bun run scripts/run-prisma.ts studio",
    "db:push": "bun run scripts/run-prisma.ts db push",
    "prepare": "husky"
  },
  "keywords": [
    "letterboxd",
    "movies",
    "api",
    "hono",
    "prisma",
    "typescript"
  ],
  "author": "Letterboxd API Contributors",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.19.4",
    "@prisma/client": "^6.5.0",
    "cheerio": "^1.0.0",
    "hono": "^4.7.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.8",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
