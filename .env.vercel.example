################################################################################
# Vercel / production env (minimal)
# Copy values into Vercel → Settings → Environment Variables
# or: bun run setup:vercel  (after vercel link + vars exist in the project)
# Full local template: .env.example · Guide: docs/vercel.md
################################################################################

# Required — Supabase Supavisor *transaction* pooler (port 6543) for serverless
# Copy from Dashboard → Connect → Transaction. Username is often postgres.<project-ref>
# Always include schema=public and pgbouncer=true (disables Prisma prepared statements)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public

NODE_ENV=production

# Strongly recommended
AUTH_ENABLED=true
AUTH_METHODS=api_key
AUTH_TOKENS=
AUTH_PUBLIC_PATHS=/health,/privacy,/openapi-gpt-actions.yaml
CORS_ORIGIN=*

# Optional
# OPENAI_API_KEY=
# LOG_LEVEL=info
# CACHE_TTL=300
# USER_SYNC_TTL_SECONDS=43200
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
# LETTERBOXD_TIMEOUT=15000
# LETTERBOXD_PAGE_DELAY_MS=500

# Not needed on Vercel: PORT, discrete DB_* (if DATABASE_URL is set)
