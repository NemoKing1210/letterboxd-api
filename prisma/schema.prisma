generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id              String              @id @default(cuid())
  username        String              @unique
  followingCount  Int?
  followersCount  Int?
  /// Snapshot from Letterboxd profile: [{ label, url }]
  externalLinks   Json                @default("[]")
  /// Pinned favorite films on profile: [{ slug, title, year, poster }]
  favoriteFilms   Json                @default("[]")
  /// Recent likes on profile: [{ slug, title, year, poster }]
  recentLikes     Json                @default("[]")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  movies          UserMovie[]
  syncs           SyncHistory[]
  tasteEmbedding  UserTasteEmbedding?
}

model Movie {
  id        String          @id @default(cuid())
  title     String
  year      Int?
  tmdbId    Int?
  poster    String?
  genres    String[]        @default([])
  director  String?
  slug      String?         @unique
  /// Internal: film-page metadata has been fetched (not exposed in API)
  enriched  Boolean         @default(false)
  users     UserMovie[]
  embedding MovieEmbedding?

  @@index([year])
  @@index([director])
  @@index([enriched])
}

/// Movie text embedding (pgvector). Read/write via EmbeddingRepository raw SQL.
model MovieEmbedding {
  movieId   String                     @id
  movie     Movie                      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  model     String
  updatedAt DateTime                   @updatedAt
}

/// Aggregated user taste vector derived from highly rated / favorite films.
model UserTasteEmbedding {
  userId     String                     @id
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  embedding  Unsupported("vector(1536)")
  model      String
  sourceHash String
  updatedAt  DateTime                   @updatedAt
}

model UserMovie {
  id          String    @id @default(cuid())
  userId      String
  movieId     String
  rating      Float?
  favorite    Boolean   @default(false)
  watchedDate DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie       Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId, rating])
  @@index([userId, watchedDate])
  @@index([userId, favorite])
}

model SyncHistory {
  id         String     @id @default(cuid())
  userId     String?
  username   String
  status     SyncStatus @default(PENDING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([username, startedAt])
  @@index([status])
}
